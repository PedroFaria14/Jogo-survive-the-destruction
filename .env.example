# Copie este arquivo como .env e preencha com seus valores locais.
# NUNCA commite o arquivo .env real nem credenciais reais em qualquer arquivo.
# Conexão com o PostgreSQL (produção: Neon) — use placeholders.
DATABASE_URL="postgresql://SEU_USUARIO:SUA_SENHA@SEU_HOST:5432/SEU_DB?sslmode=require"
# Nome/porta do servidor HTTP (opcional)
HTTP_ADDR=:8080
# Origens permitidas para o WebSocket (separadas por vírgula) (opcional)
ALLOWED_ORIGINS=http://localhost:5173
