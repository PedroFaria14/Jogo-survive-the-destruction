# Copie este arquivo como .env e preencha com seus valores locais.
# NUNCA commite o arquivo .env real.
DATABASE_URL=user=postgres password=1234567 dbname=survive_the_destruction host=localhost sslmode=disable
# Nome/porta do servidor HTTP (opcional)
HTTP_ADDR=:8080
# Origens permitidas para o WebSocket (separadas por vírgula) (opcional)
ALLOWED_ORIGINS=http://localhost:5173