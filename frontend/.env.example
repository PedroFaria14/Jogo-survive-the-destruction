# Copie este arquivo como .env e preencha com seus valores locais.
# NUNCA commite o arquivo .env real.
# URL do WebSocket do backend (produção: domínio público atual)
VITE_WS_URL=wss://api.survive.phfaria.com/ws
# URL base da API: sem /api no final; a aplicação normaliza barras finais.
VITE_API_URL=https://api.survive.phfaria.com
# Desenvolvimento local: VITE_API_URL=http://localhost:8080
# e VITE_WS_URL=ws://localhost:8080/ws
