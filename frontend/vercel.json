{
  "framework": "vite",
  "installCommand": "npx --yes pnpm@10.34.9 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@10.34.9 run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://jogo-survive-the-destruction.onrender.com wss://jogo-survive-the-destruction.onrender.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
